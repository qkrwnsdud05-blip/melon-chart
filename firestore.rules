rules_version = '2';

// 엄마 노래 USB - Firestore 보안 규칙
// 아래 목록에 있는 구글 계정만 읽고 쓸 수 있습니다.
// 엄마 계정을 넣으려면 'MOM_EMAIL@gmail.com' 을 엄마 구글 이메일로 바꾸세요. (소문자로)
service cloud.firestore {
  match /databases/{database}/documents {

    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'qkrwnsdud05@gmail.com',
          'MOM_EMAIL@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if isFamily();
    }
  }
}
